generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Channel {
  POS
  WAREHOUSE
  STOREFRONT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OfferStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum EventStatus {
  PENDING
  PROCESSED
  FAILED
}

model Customer {
  id               String   @id @default(uuid())
  email            String   @unique
  firstName        String
  lastName         String?
  phone            String?
  loyaltyTier      String   @default("STANDARD")
  consentMarketing Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  posTransactions  PosTransaction[]
  storefrontOrders StorefrontOrder[]

  @@index([lastName])
}

model Product {
  id        String   @id @default(uuid())
  sku       String   @unique
  name      String
  category  String?
  price     Decimal  @db.Decimal(10, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryItems InventoryItem[]
  offers         Offer[]
  posItems       PosTransactionItem[]
  orderItems     StorefrontOrderItem[]

  @@index([category])
}

model InventoryItem {
  id        String   @id @default(uuid())
  channel   Channel
  quantity  Int      @default(0)
  location  String?
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([productId, channel])
  @@index([channel])
}

model PosTransaction {
  id         String       @id @default(uuid())
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id])
  email      String?
  total      Decimal      @db.Decimal(10, 2)
  occurredAt DateTime     @default(now())
  createdAt  DateTime     @default(now())

  items PosTransactionItem[]

  @@index([email])
  @@index([occurredAt])
}

model PosTransactionItem {
  id            String         @id @default(uuid())
  transactionId String
  transaction   PosTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product        @relation(fields: [productId], references: [id])
  quantity      Int
  unitPrice     Decimal        @db.Decimal(10, 2)

  @@index([transactionId])
}

model StorefrontOrder {
  id         String      @id @default(uuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  status     OrderStatus @default(PENDING)
  total      Decimal     @db.Decimal(10, 2)
  placedAt   DateTime    @default(now())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items     StorefrontOrderItem[]
  shipments Shipment[]

  @@index([customerId])
  @@index([status])
}

model StorefrontOrderItem {
  id        String          @id @default(uuid())
  orderId   String
  order     StorefrontOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal         @db.Decimal(10, 2)

  @@index([orderId])
}

model Offer {
  id          String      @id @default(uuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  code        String      @unique
  title       String
  discountPct Int
  startsAt    DateTime
  endsAt      DateTime
  status      OfferStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
}

model Shipment {
  id             String         @id @default(uuid())
  orderId        String
  order          StorefrontOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier        String
  trackingNumber String?        @unique
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orderId])
  @@index([status])
}

model IntegrationEvent {
  id          String      @id @default(uuid())
  source      String
  topic       String
  payload     Json
  status      EventStatus @default(PENDING)
  occurredAt  DateTime    @default(now())
  processedAt DateTime?
  createdAt   DateTime    @default(now())

  @@index([source, occurredAt])
  @@index([status])
}

model AuditLog {
  id       String   @id @default(uuid())
  actor    String
  action   String
  entity   String
  entityId String?
  detail   Json?
  at       DateTime @default(now())

  @@index([entity, at])
}
